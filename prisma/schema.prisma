generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String?
  timezone    String   @default("America/Sao_Paulo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  connections     ProviderConnection[]
  listeningEvents ListeningEvent[]
}

model ProviderConnection {
  id               String    @id @default(uuid())
  userId           String
  provider         String    // e.g. "lastfm"
  username         String
  status           String    @default("ACTIVE") // ACTIVE, ERROR, SYNCING
  encryptedTokens  String?
  lastSyncedAt     DateTime?
  historicalCursor String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncRuns SyncRun[]

  @@unique([userId, provider])
}

model SyncRun {
  id               String    @id @default(uuid())
  connectionId     String
  type             String    // HISTORICAL, INCREMENTAL
  status           String    // RUNNING, COMPLETED, FAILED
  cursor           String?
  fetchedCount     Int       @default(0)
  insertedCount    Int       @default(0)
  duplicateCount   Int       @default(0)
  errorCode        String?
  errorMessage     String?
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt(sort: Desc)])
}

model Artist {
  id             String   @id @default(uuid())
  name           String
  normalizedName String
  mbid           String?
  metadataStatus String   @default("UNRESOLVED") // UNRESOLVED, RESOLVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tracks          Track[]
  albums          Album[]
  listeningEvents ListeningEvent[]

  @@index([normalizedName])
}

model Track {
  id             String   @id @default(uuid())
  artistId       String
  name           String
  normalizedName String
  durationMs     Int?
  mbid           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  artist          Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  listeningEvents ListeningEvent[]

  @@index([artistId, normalizedName])
}

model Album {
  id             String   @id @default(uuid())
  artistId       String
  name           String
  normalizedName String
  releaseYear    Int?
  mbid           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  artist          Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  listeningEvents ListeningEvent[]

  @@index([artistId, normalizedName])
}

model ListeningEvent {
  id               String   @id @default(uuid())
  userId           String
  playedAt         DateTime // Stored in UTC
  provider         String   // "lastfm"
  providerEventKey String   // sha256(userId + "|lastfm|" + timestamp + "|" + normalizedArtist + "|" + normalizedTrack)
  rawArtistName    String
  rawTrackName     String
  rawAlbumName     String?
  artistId         String?
  trackId          String?
  albumId          String?
  createdAt        DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist? @relation(fields: [artistId], references: [id], onDelete: SetNull)
  track  Track?  @relation(fields: [trackId], references: [id], onDelete: SetNull)
  album  Album?  @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@unique([userId, provider, providerEventKey])
  @@index([userId, playedAt(sort: Desc)])
  @@index([userId, artistId, playedAt])
  @@index([userId, trackId, playedAt])
}
