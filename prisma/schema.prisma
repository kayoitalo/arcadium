generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String?
  timezone    String   @default("America/Sao_Paulo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  connections     ProviderConnection[]
  listeningEvents ListeningEvent[]
  sessions        RecommendationSession[]
  feedbacks       RecommendationFeedback[]
  aiRuns          AIAnalysisRun[]
  playlistExports PlaylistExport[]
}

model ProviderConnection {
  id               String    @id @default(uuid())
  userId           String
  provider         String    // e.g. "lastfm"
  username         String
  status           String    @default("ACTIVE") // ACTIVE, ERROR, SYNCING
  encryptedTokens  String?
  lastSyncedAt     DateTime?
  historicalCursor String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncRuns SyncRun[]

  @@unique([userId, provider])
}

model SyncRun {
  id               String    @id @default(uuid())
  connectionId     String
  type             String    // HISTORICAL, INCREMENTAL
  status           String    // RUNNING, COMPLETED, FAILED
  cursor           String?
  fetchedCount     Int       @default(0)
  insertedCount    Int       @default(0)
  duplicateCount   Int       @default(0)
  errorCode        String?
  errorMessage     String?
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt(sort: Desc)])
}

model Artist {
  id             String    @id @default(uuid())
  name           String
  normalizedName String
  mbid           String?
  country        String?   // e.g. "US", "GB", "SE"
  type           String?   // e.g. "Group", "Person", "Orchestra"
  disambiguation String?
  tags           String?   // Comma-separated or JSON list of top tags/genres
  metadataStatus String    @default("UNRESOLVED") // UNRESOLVED, RESOLVED, FAILED
  enrichedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tracks          Track[]
  albums          Album[]
  listeningEvents ListeningEvent[]

  @@index([normalizedName])
  @@index([metadataStatus])
}

model Track {
  id             String    @id @default(uuid())
  artistId       String
  name           String
  normalizedName String
  durationMs     Int?
  mbid           String?
  enrichedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  artist          Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  listeningEvents ListeningEvent[]

  @@index([artistId, normalizedName])
}

model Album {
  id             String    @id @default(uuid())
  artistId       String
  name           String
  normalizedName String
  releaseYear    Int?
  primaryType    String?   // e.g. "Album", "EP", "Single"
  mbid           String?
  releaseGroupMbid String?
  releaseGroupFetchedAt DateTime?
  coverUrl       String?
  coverSource    String?
  coverEntityType String?
  coverMbid      String?
  coverFetchedAt DateTime?
  enrichedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  artist          Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  listeningEvents ListeningEvent[]

  @@index([artistId, normalizedName])
  @@index([coverFetchedAt])
  @@index([releaseGroupMbid])
  @@index([releaseGroupFetchedAt])
}

model ListeningEvent {
  id               String   @id @default(uuid())
  userId           String
  playedAt         DateTime // Stored in UTC
  provider         String   // "lastfm"
  providerEventKey String   // sha256(userId + "|lastfm|" + timestamp + "|" + normalizedArtist + "|" + normalizedTrack)
  rawArtistName    String
  rawTrackName     String
  rawAlbumName     String?
  artistId         String?
  trackId          String?
  albumId          String?
  createdAt        DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist? @relation(fields: [artistId], references: [id], onDelete: SetNull)
  track  Track?  @relation(fields: [trackId], references: [id], onDelete: SetNull)
  album  Album?  @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@unique([userId, provider, providerEventKey])
  @@index([userId, playedAt(sort: Desc)])
  @@index([userId, artistId, playedAt])
  @@index([userId, trackId, playedAt])
}

// ─── Recommendation Engine ───────────────────────────────────────────

model RecommendationSession {
  id               String   @id @default(uuid())
  userId           String
  mode             String   // SAFE, BALANCED, EXPERIMENTAL
  context          String?  // GENERAL, WORKING, STUDYING, EXERCISING, RELAXING
  profilePeriod    String   @default("30d") // Period used for profile building
  algorithmVersion String   @default("v1")
  status           String   @default("ACTIVE") // ACTIVE, COMPLETED, EXPIRED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   RecommendationItem[]
  exports PlaylistExport[]

  @@index([userId, createdAt(sort: Desc)])
}

model RecommendationItem {
  id              String  @id @default(uuid())
  sessionId       String
  artistName      String
  trackName       String
  albumName       String?
  genre           String?
  score           Float   // Final composite score (0-100)
  noveltyScore    Float?  // Novelty sub-score
  scoreComponents Json?   // { artistSimilarity, genreSimilarity, profileRelevance, noveltyFit, feedbackFit, metadataConfidence }
  rank            Int     // Position in ranked list
  status          String  @default("PENDING") // PENDING, LIKED, DISLIKED, KNOWN, NOT_INTERESTED, SAVED
  reason          String? // Human-readable explanation
  artistId        String? // Link to canonical Artist if resolved
  trackId         String? // Link to canonical Track if resolved
  createdAt       DateTime @default(now())

  session  RecommendationSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  feedback RecommendationFeedback[]

  @@index([sessionId, rank])
}

model RecommendationFeedback {
  id        String   @id @default(uuid())
  itemId    String
  userId    String
  type      String   // LIKED, DISLIKED, ALREADY_KNOW, NOT_INTERESTED, SAVE_FOR_LATER
  note      String?
  createdAt DateTime @default(now())

  item RecommendationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([itemId])
}

// ─── AI Analysis ─────────────────────────────────────────────────────

model AIAnalysisRun {
  id              String   @id @default(uuid())
  userId          String
  kind            String   // PROFILE_NARRATIVE, RECOMMENDATION_EXPLANATION
  provider        String   @default("gemini")
  model           String?  // e.g. "gemini-3.5-flash"
  promptVersion   String   @default("v1")
  inputHash       String?  // SHA-256 of structured input for dedup/caching
  validatedOutput Json?    // The Zod-validated structured output
  rawOutput       String?  // Raw model response for debugging
  status          String   @default("PENDING") // PENDING, COMPLETED, FAILED
  tokenCount      Int?     // Input + output tokens
  errorMessage    String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt(sort: Desc)])
  @@index([inputHash])
}

// ─── Playlist Export ─────────────────────────────────────────────────

model PlaylistExport {
  id                 String   @id @default(uuid())
  sessionId          String
  userId             String
  providerPlaylistId String?  // Spotify playlist ID
  playlistUrl        String?
  mode               String   // SPOTIFY_API, FALLBACK_PLAYLIST
  selectedItemIds    Json?    // Array of RecommendationItem IDs that were exported
  totalItems         Int      @default(0)
  resolvedCount      Int      @default(0)
  createdAt          DateTime @default(now())

  session RecommendationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}
