# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host:5432/spotstats?sslmode=require"

# Application Secrets
AUTH_SECRET="change-me-in-production-with-at-least-32-chars"
APP_ENCRYPTION_KEY="change-me-32-byte-secret-key-for-tokens"
CRON_SECRET="change-me-cron-secret-token"

# Last.fm Ingestion Foundation
LASTFM_API_KEY="your_lastfm_api_key"
LASTFM_USER_AGENT="SpotStats/0.1.0 (contact@example.com)"

# Optional Metadata & AI Providers (Deferred to Later Milestones)
MUSICBRAINZ_USER_AGENT="SpotStats/0.1.0 (contact@example.com)"
AI_PROVIDER="gemini"
AI_MODEL="gemini-1.5-flash"
GEMINI_API_KEY=""

# Optional Spotify Playlist Export (Deferred to Later Milestones)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://localhost:3000/api/auth/callback/spotify"
