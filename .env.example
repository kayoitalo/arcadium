# Required core infrastructure
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Required only when Last.fm synchronization is enabled
LASTFM_API_KEY=""
LASTFM_USER_AGENT="SpotStats/0.1.0 (contact@example.com)"

# Optional metadata enrichment
MUSICBRAINZ_USER_AGENT="MusicIntelligence/0.1 (contact@example.com)"

# Optional AI narrative; the application uses a deterministic fallback without it
GEMINI_API_KEY=""
AI_MODEL="gemini-2.0-flash"

# Recommended for scheduled synchronization in production
CRON_SECRET=""

NODE_ENV="development"
